---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("jobs");
  return entries
    .filter((entry) => entry.slug !== "placeholder")
    .map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const attachment = entry.data.attachment;
const isPdf = attachment?.toLowerCase().endsWith(".pdf");
const isImage = attachment ? /\.(avif|bmp|gif|jpe?g|png|svg|tiff?|webp)$/i.test(attachment) : false;
---
<BaseLayout title={entry.data.title}>
  <section class="page-hero"><div class="container"><p class="eyebrow">Job opportunity</p><h1>{entry.data.title}</h1><p>{entry.data.department}</p></div></section>
  <section class="container section prose">
    <p><strong>Posted:</strong> {entry.data.postedDate.toLocaleDateString()} · <strong>Closing:</strong> {entry.data.closingDate.toLocaleDateString()}</p>
    <Content />
    <h2>How to apply</h2><p>{entry.data.howToApply}</p>
    {attachment && <section class="public-attachments" aria-labelledby="job-attachment-title">
      <h2 id="job-attachment-title">Advert Attachment</h2>
      {isPdf && <iframe class="public-pdf-preview" src={attachment} title={`Preview of ${entry.data.title} advert`}></iframe>}
      {isImage && <img class="public-image-preview" src={attachment} alt={`Preview of ${entry.data.title} advert`} />}
      <p><a class="button" href={attachment} target="_blank" rel="noreferrer">Open Or Download Advert</a></p>
    </section>}
  </section>
</BaseLayout>
