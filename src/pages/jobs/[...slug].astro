---
import { getCollection } from "astro:content";
import PublicLayout from "../../layouts/PublicLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("jobs");
  return entries.filter((entry) => entry.slug !== "placeholder").map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", year: "numeric" }).format(date);
const attachment = entry.data.attachment;
const jobPosting = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  title: entry.data.title,
  description: entry.data.description,
  datePosted: entry.data.postedDate.toISOString().slice(0, 10),
  validThrough: entry.data.closingDate.toISOString(),
  hiringOrganization: { "@type": "Organization", name: "Mathioya Technical & Vocational College" },
  jobLocation: { "@type": "Place", address: { "@type": "PostalAddress", addressCountry: "KE" } },
};
---
<PublicLayout title={entry.data.title} description={entry.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jobPosting)} />
  <section class="page-hero"><div class="container"><p class="eyebrow">Job opportunity</p><h1>{entry.data.title}</h1><p>{entry.data.department}</p></div></section>
  <section class="container section detail-page">
    <a class="back-link" href="/jobs/">← Back to all jobs</a>
    <div class="detail-meta"><span>Posted {formatDate(entry.data.postedDate)}</span><span>Closing {formatDate(entry.data.closingDate)}</span></div>
    <div class="prose"><p>{entry.data.description}</p><Content /><h2>How to apply</h2><p>{entry.data.howToApply}</p></div>
    {attachment && <section class="public-attachments"><h2>Advert attachment</h2>{attachment.toLowerCase().endsWith(".pdf") && <iframe class="public-pdf-preview" src={attachment} title={`Preview of ${entry.data.title} advert`}></iframe>}<a class="button button-danger" href={attachment} target="_blank" rel="noreferrer">Download notice</a></section>}
  </section>
</PublicLayout>
