---
import { getCollection } from "astro:content";
import { activeJobs, archivedJobs } from "../../lib/content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const entries = await getCollection("jobs");
const current = activeJobs(entries).filter((entry) => entry.slug !== "placeholder");
const archive = archivedJobs(entries).filter((entry) => entry.slug !== "placeholder");
---
<BaseLayout title="Jobs">
  <section class="page-hero"><div class="container"><p class="eyebrow">Opportunities</p><h1>Jobs</h1></div></section>
  <section class="container section">
    <h2>Current vacancies</h2>
    {current.length ? <div class="card-grid three">{current.map((entry) => <a class="card card-link" href={`/jobs/${entry.slug}/`}><h3>{entry.data.title}</h3><p>{entry.data.department}</p><small>Closes {entry.data.closingDate.toLocaleDateString()}</small></a>)}</div> : <p>No current job adverts are published.</p>}
    {archive.length > 0 && <><h2 class="archive-heading">Recent archive</h2><div class="card-grid three">{archive.map((entry) => <a class="card card-link" href={`/jobs/${entry.slug}/`}><h3>{entry.data.title}</h3><p>Closed {entry.data.closingDate.toLocaleDateString()}</p></a>)}</div></>}
  </section>
</BaseLayout>
