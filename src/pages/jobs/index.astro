---
import { getCollection } from "astro:content";
import PublicLayout from "../../layouts/PublicLayout.astro";
import { activeJobs, archivedJobs, isClosingSoon } from "../../lib/content";

const entries = await getCollection("jobs");
const openJobs = activeJobs(entries).filter((entry) => entry.slug !== "placeholder");
const closedJobs = archivedJobs(entries).filter((entry) => entry.slug !== "placeholder");
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", year: "numeric" }).format(date);
const status = (date: Date) => isClosingSoon(date) ? "Closing soon" : "Open";
---
<PublicLayout title="Jobs" description="Current job opportunities at Mathioya Technical & Vocational College.">
  <section class="page-hero"><div class="container"><p class="eyebrow">Opportunities</p><h1>Jobs</h1><p>Current vacancies and opportunities at Mathioya Technical & Vocational College.</p></div></section>
  <section class="container section listing-page">
    <div class="section-heading"><div><p class="eyebrow">Open positions</p><h2>{openJobs.length} open {openJobs.length === 1 ? "position" : "positions"}</h2></div></div>
    {openJobs.length ? <div class="notice-list" aria-label="Open jobs">{openJobs.map((entry) => (
      <article class="notice-row">
        <div class="notice-main"><div class="notice-title-line"><h3><a href={`/jobs/${entry.slug}/`}>{entry.data.title}</a></h3><span class:list={["status-badge", isClosingSoon(entry.data.closingDate) ? "status-soon" : "status-open"]}>{status(entry.data.closingDate)}</span></div><p>{entry.data.department}</p><small>Closing {formatDate(entry.data.closingDate)}</small></div>
        <div class="notice-actions"><a class="button button-small" href={`/jobs/${entry.slug}/`}>View details</a>{entry.data.attachment?.toLowerCase().endsWith(".pdf") && <a class="button button-small button-outline-dark" href={entry.data.attachment} target="_blank" rel="noreferrer">Download notice</a>}</div>
      </article>
    ))}</div> : <p class="empty-state">There are no open positions at the moment. Please check back soon or <a href="/#page-contact">contact the college</a>.</p>}
    {closedJobs.length > 0 && <details class="closed-notices"><summary>Closed notices ({closedJobs.length})</summary><div class="notice-list">{closedJobs.map((entry) => <article class="notice-row notice-row-closed"><div class="notice-main"><div class="notice-title-line"><h3><a href={`/jobs/${entry.slug}/`}>{entry.data.title}</a></h3><span class="status-badge status-closed">Closed</span></div><p>{entry.data.department}</p><small>Closed {formatDate(entry.data.closingDate)}</small></div><div class="notice-actions"><a class="button button-small" href={`/jobs/${entry.slug}/`}>View details</a>{entry.data.attachment?.toLowerCase().endsWith(".pdf") && <a class="button button-small button-outline-dark" href={entry.data.attachment} target="_blank" rel="noreferrer">Download notice</a>}</div></article>)}</div></details>}
  </section>
</PublicLayout>
