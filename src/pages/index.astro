    intro: "Develop practical construction skills in building, masonry, plumbing, surveying, and site practice for the built environment.",
    objectives: ["Build competence in construction tools, materials, and methods", "Apply safe and accurate workshop and site practices", "Prepare trainees for construction employment and independent work"],
    programs: ["Building Technology", "Masonry and Plumbing", "Civil engineering support skills"],
  },
  {
    id: "dept-electrical",
    short: "Electrical",
    title: "Electrical & Electronics Engineering",
    image: "https://images.unsplash.com/photo-1621905252507-b35492cc74b4?q=80&w=700&auto=format&fit=crop",
    alt: "Electrical engineering practical training",
    intro: "Learn to install, maintain, test, and troubleshoot electrical and electronic systems with an emphasis on safe, practical application.",
    objectives: ["Apply electrical installation and testing procedures safely", "Develop skills in wiring, maintenance, and fault diagnosis", "Build foundations for technical service and energy-related enterprises"],
    programs: ["Electrical Installation", "Electrical and Electronics Engineering", "Solar and basic electrical short courses"],
  },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mathioya Technical & Vocational College</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --color-primary:#005485;
    --color-accent:#eb232b;
    --color-highlight:#ffee6d;
    --color-text:#403f37;
    --color-heading:#0a0500;
    --color-bg:#ffffff;
    --color-bg-soft:#f9fafb;
    --color-bg-off:#fdfdfd;
    --color-border:#edeff2;
    --color-rule:#f2f1f1;
    --color-on-primary:#ffffff;
    --color-on-accent:#ffffff;
    --color-on-highlight:#0a0500;
    --navy:var(--color-primary);
    --navy-deep:var(--color-primary);
    --red:var(--color-accent);
    --gold:var(--color-highlight);
    --paper:var(--color-bg);
    --paper-dim:var(--color-bg-soft);
    --ink:var(--color-text);
    --ink-soft:var(--color-text);
    --line:var(--color-border);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Inter', sans-serif;
    background:var(--paper);
    color:var(--ink);
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Space Grotesk', sans-serif;
    font-weight:600;
    letter-spacing:-0.01em;
    color:var(--navy-deep);
  }
  a{color:inherit; text-decoration:none; cursor:pointer;}
  img, iframe, video, embed, object{max-width:100%; display:block;}
  ul{list-style:none;}
  .wrap{width:100%; max-width:1180px; min-width:0; margin:0 auto; padding:0 32px;}
  .page{display:none;}
  .page.active{display:block; animation:fadein .25s ease;}
  @keyframes fadein{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;}}

  /* ===== Utility bar ===== */
  .utility{background:var(--navy-deep); color:var(--color-on-primary); font-size:12.5px; letter-spacing:0.02em;}
  .utility .wrap{display:flex; justify-content:space-between; align-items:center; height:36px;}
  .utility-links{display:flex; gap:22px; min-width:0;}
  .utility-links a{opacity:0.85; transition:opacity .15s;}
  .utility-links a:hover{opacity:1; color:#fff;}
  .utility-social{display:flex; gap:16px; min-width:0;}
  .utility-social .social-icon{display:none;}
  .utility-social a{opacity:0.7; transition:opacity .15s;}
  .utility-social a:hover{opacity:1;}

  /* ===== Nav ===== */
  header.main{background:var(--paper); border-bottom:1px solid var(--line); position:sticky; top:0; z-index:50; backdrop-filter:blur(6px); box-shadow:0 2px 14px rgba(0,84,133,.1);}
  nav.wrap{position:relative; display:flex; align-items:center; justify-content:flex-start; width:100%; max-width:none; margin:0; height:76px;}
  .brand{display:flex; flex:1 1 auto; align-items:center; gap:12px; min-width:0;}
  .crest{width:42px; height:42px; flex:0 0 42px; object-fit:contain;}
  .brand-text .name{font-size:15px; font-weight:600; color:var(--navy-deep); line-height:1.15;}
  .nav-links{display:flex; flex:0 0 auto; align-items:center; gap:30px; min-width:0; margin-left:auto; font-size:14px; font-weight:500;}
  .nav-links a,.nav-parent{color:var(--ink); position:relative; padding:6px 0;}
  .nav-parent{border:0; background:none; font:inherit; cursor:pointer;}
  .nav-links a:hover{color:var(--navy)}
  .nav-links a.active{color:var(--navy)}
  .nav-links a.active::after{content:''; position:absolute; left:0; right:0; bottom:-2px; height:2px; background:var(--red);}
  .nav-links .has-drop{position:relative; min-width:0;}
  .drop{
    position:absolute; top:calc(100% + 14px); left:50%; transform:translateX(-50%);
    background:#fff; border:1px solid var(--line); border-radius:10px; padding:8px;
    min-width:250px; box-shadow:0 20px 40px -14px rgba(15,42,70,0.18);
    opacity:0; visibility:hidden; transition:all .15s;
  }
  .has-drop:hover .drop{opacity:1; visibility:visible; top:calc(100% + 8px);}
  .drop a{display:block; padding:9px 12px; border-radius:6px; font-size:13.5px;}
  .drop a:hover{background:var(--paper-dim); color:var(--navy);}
  .nav-cta{display:flex; flex:0 0 auto; align-items:center; gap:16px; margin-left:24px;}
  .btn{display:inline-flex; align-items:center; gap:8px; padding:10px 20px; font-size:13.5px; font-weight:600; border-radius:6px; transition:all .15s; font-family:'Inter', sans-serif; border:none; cursor:pointer;}
  .btn-primary{background:var(--navy); color:#fff;}
  .btn-primary:hover{background:var(--navy-deep);}
  .btn-ghost{color:var(--navy); border:1px solid var(--line); background:none;}
  .btn-ghost:hover{border-color:var(--navy);}
  .btn-red{background:var(--red); color:#fff;}
  .btn-red:hover{background:#9C2A22;}
  .btn-outline{border:1px solid rgba(255,255,255,0.28); color:#fff; background:none;}
  .btn-outline:hover{border-color:#fff;}
  .mobile-toggle{display:none; width:42px; height:42px; padding:0; border:1px solid var(--line); border-radius:6px; background:var(--paper); color:var(--navy-deep); font-size:22px; cursor:pointer;}

  /* ===== Hero (home) ===== */
  .hero{position:relative; background:linear-gradient(120deg, var(--navy-deep) 0%, var(--navy) 60%); overflow:hidden; color:#fff;}
  .hero::after{content:''; position:absolute; right:-10%; top:-20%; width:600px; height:600px; border-radius:50%; background:radial-gradient(circle, rgba(217,169,59,0.14) 0%, transparent 70%);}
  .hero-inner{position:relative; z-index:2; display:grid; grid-template-columns:1.1fr 0.9fr; gap:60px; min-width:0; align-items:center; padding:96px 32px 100px;}
  .eyebrow{display:inline-flex; align-items:center; gap:8px; font-size:12.5px; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:var(--gold); margin-bottom:22px;}
  .eyebrow::before{content:''; width:18px; height:2px; background:var(--red); display:inline-block;}
  .hero h1{font-size:46px; line-height:1.08; color:#fff; margin-bottom:22px; max-width:560px;}
  .hero p.lead{font-size:16.5px; color:var(--color-on-primary); max-width:460px; margin-bottom:32px;}
  .hero-actions{display:flex; gap:14px; margin-bottom:44px;}
  .hero-stats{display:flex; gap:36px;}
  .hero-stats div .num{font-family:'Space Grotesk',sans-serif; font-size:26px; font-weight:700; color:#fff;}
  .hero-stats div .label{font-size:12px; color:var(--color-on-primary); margin-top:2px;}
  .hero-visual{position:relative; z-index:2; border-radius:14px; overflow:hidden; aspect-ratio:4/5; background:var(--color-primary); display:flex; align-items:flex-end; box-shadow:0 30px 60px -20px rgba(10,5,0,0.5);}
  .hero-slide{position:absolute; inset:0; opacity:0; transition:opacity .55s ease; pointer-events:none;}
  .hero-slide.active{opacity:1; pointer-events:auto;}
  .hero-visual img{width:100%; height:100%; object-fit:cover; opacity:0.92;}
  .hero-dots{position:absolute; z-index:3; top:18px; right:18px; display:flex; gap:6px;}
  .hero-dot{width:8px; height:8px; padding:0; border:1px solid var(--color-on-primary); border-radius:50%; background:transparent; cursor:pointer;}
  .hero-dot.active{background:var(--color-highlight);}
  .hero-visual-tag{position:absolute; left:20px; bottom:20px; right:20px; background:rgba(10,29,51,0.72); backdrop-filter:blur(8px); border-radius:10px; padding:14px 16px; display:flex; align-items:center; gap:10px;}
  .hero-visual-tag .dot{width:8px; height:8px; border-radius:50%; background:var(--gold); flex-shrink:0;}
  .hero-visual-tag span{font-size:12.5px; color:var(--color-on-primary);}

  .announcement-ribbon{position:relative; overflow:hidden; border-bottom:1px solid rgba(255,255,255,.15); background:var(--navy-deep); color:#fff;}
  .announcement-ribbon::before,.announcement-ribbon::after{position:absolute; top:0; bottom:0; z-index:2; width:48px; content:""; pointer-events:none;}
  .announcement-ribbon::before{left:0; background:linear-gradient(90deg,var(--navy-deep),transparent);}
  .announcement-ribbon::after{right:0; background:linear-gradient(270deg,var(--navy-deep),transparent);}
  .announcement-track{display:flex; width:max-content; animation:announcement-scroll 28s linear infinite;}
  .announcement-track:hover,.announcement-track:focus-within{animation-play-state:paused;}
  .announcement-item{display:flex; align-items:center; gap:10px; min-height:44px; padding:0 34px; border-right:1px solid rgba(255,255,255,.16); color:#fff; font-size:13px; font-weight:600; white-space:nowrap;}
  .announcement-item::before{width:7px; height:7px; flex:0 0 7px; border-radius:50%; background:var(--gold); content:"";}
  .announcement-item:hover,.announcement-item:focus-visible{color:var(--gold);}
  @keyframes announcement-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @media(prefers-reduced-motion:reduce){.announcement-track{animation:none; width:100%; justify-content:center; flex-wrap:wrap;}.announcement-item{min-height:38px;}}
  @media(max-width:600px){.announcement-item{padding:0 22px; font-size:12px;}.announcement-ribbon::before,.announcement-ribbon::after{width:24px;}}

  .notice-list{display:grid; gap:16px; max-width:920px; margin-top:28px;}
  .notice-row{display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:24px; min-width:0; padding:18px 20px; border:1px solid var(--color-border); border-left:3px solid var(--color-primary); border-radius:12px; background:var(--color-bg); box-shadow:0 8px 22px rgba(0,84,133,.06); transition:border-color .15s, box-shadow .15s, transform .15s;}
  .notice-row:hover{border-color:rgba(0,84,133,.35); box-shadow:0 12px 28px rgba(0,84,133,.1); transform:translateY(-1px);}
  .notice-main{min-width:0;}
  .notice-title-line{display:flex; align-items:flex-start; flex-wrap:wrap; gap:8px 12px;}
  .notice-title-line h3{margin:0; color:var(--color-primary); font-size:1.05rem; line-height:1.3;}
  .notice-main p{margin:8px 0 0; color:var(--color-text); font-size:.9rem;}
  .notice-main small{display:block; margin-top:5px; color:#64727c; font-size:.8rem;}
  .notice-actions{display:flex; justify-content:flex-end; min-width:0;}
  .notice-actions .button{white-space:nowrap;}

  /* ===== Inner page header (all non-home pages) ===== */
  .page-header{background:var(--navy-deep); color:#fff; padding:56px 0 44px; position:relative; overflow:hidden;}
  .page-header::after{content:''; position:absolute; right:-8%; top:-40%; width:400px; height:400px; border-radius:50%; background:radial-gradient(circle, rgba(217,169,59,0.12) 0%, transparent 70%);}
  .page-header .wrap{position:relative; z-index:2;}
  .breadcrumb{font-size:12.5px; color:var(--color-on-primary); margin-bottom:14px; display:flex; gap:8px; align-items:center;}
  .breadcrumb a:hover{color:#fff;}
  .breadcrumb .sep{opacity:0.5;}
  .page-header h1{color:#fff; font-size:34px; max-width:640px;}
  .page-header p{color:var(--color-on-primary); font-size:14.5px; margin-top:10px; max-width:520px;}

  /* ===== Strip ===== */
  .strip{background:var(--paper-dim); border-bottom:1px solid var(--line);}
  .strip .wrap{display:flex; align-items:center; justify-content:space-between; padding:18px 32px; flex-wrap:wrap; gap:14px;}
  .strip-item{display:flex; align-items:center; gap:10px; font-size:13px; color:var(--ink-soft);}
  .strip-item b{color:var(--navy-deep); font-weight:600;}
  .strip-badge{background:var(--red); color:#fff; font-size:12px; font-weight:600; padding:4px 10px; border-radius:5px;}

  section{padding:88px 0;}
  section.tight{padding:64px 0;}
  #page-home > section{padding-block:112px;}
  .section-head{display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:48px; gap:24px; flex-wrap:wrap;}
  .section-head .kicker{font-size:12.5px; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:var(--red); margin-bottom:10px; display:block;}
  .section-head h2{font-size:30px;}
  .section-head p{color:var(--ink-soft); font-size:14.5px; max-width:420px;}

  /* ===== Departments grid ===== */
  .dept-grid{display:grid; grid-template-columns:repeat(4, 1fr); gap:1px; background:var(--line); border:1px solid var(--line); border-radius:14px; overflow:hidden;}
  .dept-card{background:#fff; padding:30px 26px; transition:background .15s; display:flex; flex-direction:column; gap:14px; min-height:170px;}
  .dept-card:hover{background:var(--paper-dim);}
  .dept-num{font-family:'Space Grotesk',sans-serif; font-size:12px; color:var(--ink-soft); font-weight:600;}
  .dept-card h3{font-size:15.5px; line-height:1.3;}
  .dept-card .arrow{margin-top:auto; font-size:13px; color:var(--red); font-weight:600; display:flex; align-items:center; gap:6px;}

  /* ===== Pillars ===== */
  .pillars{background:var(--navy-deep); color:#fff; border-radius:18px; padding:64px 56px; display:grid; grid-template-columns:repeat(3,1fr); gap:0;}
  .pillar{padding:0 32px; position:relative;}
  .pillar + .pillar{border-left:1px solid rgba(255,255,255,0.12);}
  .pillar .icon{width:36px; height:36px; border-radius:8px; background:rgba(217,169,59,0.14); display:flex; align-items:center; justify-content:center; margin-bottom:20px; color:var(--gold); font-size:16px;}
  .pillar h3{color:#fff; font-size:14px; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:12px;}
  .pillar p{font-size:15px; color:var(--color-on-primary); line-height:1.55;}

  /* ===== Principal ===== */
  .principal{display:grid; grid-template-columns:0.7fr 1.3fr; gap:56px; min-width:0; align-items:center;}
  .principal-photo{aspect-ratio:1/1.05; border-radius:16px; background:var(--paper-dim); border:1px solid var(--line); overflow:hidden;}
  .principal-photo img{width:100%; height:100%; object-fit:cover;}
  .principal blockquote{font-family:'Space Grotesk', sans-serif; font-size:22px; font-weight:500; color:var(--navy-deep); line-height:1.45; margin-bottom:22px;}
  .principal .attribution{display:flex; align-items:center; gap:12px;}
  .principal .attribution .bar{width:28px; height:2px; background:var(--red);}
  .principal .attribution .name{font-weight:600; font-size:14px; color:var(--navy-deep);}
  .principal .attribution .role{font-size:12.5px; color:var(--ink-soft);}

  /* ===== Downloads ===== */
  .downloads-panel{display:grid; grid-template-columns:0.9fr 1.1fr; gap:0; border:1px solid var(--line); border-radius:16px; overflow:hidden;}
  .downloads-left{background:var(--navy); color:#fff; padding:48px 44px; display:flex; flex-direction:column; justify-content:center;}
  .downloads-left .kicker{color:var(--gold);}
  .downloads-left h2{color:#fff; font-size:26px; margin-bottom:14px;}
  .downloads-left p{color:var(--color-on-primary); font-size:14.5px; margin-bottom:26px;}
  .downloads-right{background:#fff; padding:36px 40px; display:grid; grid-template-columns:1fr 1fr; gap:2px;}
  .dl-item{padding:16px 14px; border-radius:8px; display:flex; align-items:center; justify-content:space-between; font-size:13.5px; font-weight:500; color:var(--ink); transition:background .15s;}
  .dl-item:hover{background:var(--paper-dim); color:var(--navy);}
  .dl-item .ico{color:var(--red); font-size:13px;}

  /* ===== About page ===== */
  .about-grid{display:grid; grid-template-columns:220px minmax(0,1fr); gap:56px; min-width:0;}
  .about-nav{position:sticky; top:96px; align-self:start; min-width:0;}
  .about-nav a{display:block; padding:10px 0; font-size:13.5px; color:var(--ink-soft); border-left:2px solid var(--line); padding-left:16px; transition:all .15s;}
  .about-nav a:hover, .about-nav a.on{color:var(--navy); border-left-color:var(--red);}
  .about-block{margin-bottom:52px;}
  .about-block[id]{scroll-margin-top:112px;}
  .about-block h2{font-size:22px; margin-bottom:16px;}
  .about-block p{color:var(--ink-soft); font-size:14.5px; line-height:1.7; margin-bottom:14px;}
  .partners-section{padding-bottom:72px;}
  .partners-section .section-head{margin-bottom:28px;}
  .partners-image{display:block; width:min(100%,768px); height:auto; margin:0 auto; border:1px solid var(--line); border-radius:12px; background:#fff;}
  .values-grid{display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:8px;}
  .value-card{border:1px solid var(--line); border-radius:10px; padding:18px 20px; background:#fff;}
  .value-card b{display:block; color:var(--navy-deep); font-size:13.5px; margin-bottom:6px;}
  .value-card span{font-size:13px; color:var(--ink-soft);}
  .timeline{border-left:2px solid var(--line); padding-left:24px; margin-top:10px;}
  .timeline-item{position:relative; padding-bottom:22px;}
  .timeline-item::before{content:''; position:absolute; left:-29px; top:4px; width:9px; height:9px; border-radius:50%; background:var(--red); border:2px solid var(--paper);}
  .timeline-item .yr{font-family:'Space Grotesk',sans-serif; font-weight:600; color:var(--navy-deep); font-size:13.5px;}
  .timeline-item p{font-size:13.5px; color:var(--ink-soft); margin-top:2px;}

  /* ===== Department detail ===== */
  .dept-detail{display:grid; grid-template-columns:1fr 1.3fr; gap:56px; align-items:start;}
  .dept-detail-visual{border-radius:16px; overflow:hidden; aspect-ratio:4/3.2; border:1px solid var(--line);}
  .dept-detail-visual img{width:100%; height:100%; object-fit:cover;}
  .dept-tag{display:inline-block; background:var(--red); color:#fff; font-size:11.5px; font-weight:600; padding:4px 10px; border-radius:5px; margin-bottom:16px; letter-spacing:0.03em;}
  .dept-detail h1{font-size:28px; margin-bottom:16px;}
  .dept-detail p.intro{color:var(--ink-soft); font-size:14.5px; line-height:1.7; margin-bottom:26px;}
  .obj-list{display:flex; flex-direction:column; gap:12px; margin-bottom:28px;}
  .obj-list li{display:flex; gap:12px; font-size:13.5px; color:var(--ink); align-items:flex-start;}
  .obj-list .chk{width:18px; height:18px; border-radius:5px; background:var(--paper-dim); color:var(--red); flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:11px; margin-top:1px;}
  .programs{display:flex; flex-direction:column; gap:2px; border:1px solid var(--line); border-radius:12px; overflow:hidden;}
  .program-row{display:flex; justify-content:space-between; align-items:center; padding:16px 20px; background:#fff; font-size:13.5px;}
  .program-row:nth-child(even){background:var(--paper-dim);}
  .program-row .tag{font-size:11px; color:var(--ink-soft); border:1px solid var(--line); padding:2px 8px; border-radius:20px;}
  .other-depts{display:flex; gap:10px; flex-wrap:wrap; margin-top:40px;}
  .other-depts a{font-size:12.5px; padding:8px 14px; border:1px solid var(--line); border-radius:20px; color:var(--ink-soft); transition:all .15s;}
  .other-depts a:hover{border-color:var(--navy); color:var(--navy);}

  /* ===== Gallery ===== */
  .filter-row{display:flex; gap:10px; margin-bottom:36px; flex-wrap:wrap;}
  .filter-pill{font-size:13px; font-weight:500; padding:8px 16px; border-radius:20px; border:1px solid var(--line); color:var(--ink-soft); cursor:pointer; transition:all .15s;}
  .filter-pill.on, .filter-pill:hover{background:var(--navy); border-color:var(--navy); color:#fff;}
  .masonry{columns:4 220px; column-gap:14px;}
  .masonry img{display:block; width:100%; height:auto; aspect-ratio:auto; object-fit:contain; border-radius:10px; margin-bottom:14px; break-inside:avoid; border:1px solid var(--line);}

  /* ===== Contact ===== */
  .contact-grid{display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:56px; align-items:start;}
  .contact-cards{display:flex; flex-direction:column; gap:2px; border:1px solid var(--line); border-radius:14px; overflow:hidden; margin-bottom:28px;}
  .contact-card{display:flex; gap:16px; padding:20px 22px; background:#fff; align-items:flex-start;}
  .contact-card .icon{width:38px; height:38px; border-radius:9px; background:var(--paper-dim); color:var(--red); display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0;}
  .contact-card b{display:block; font-size:13.5px; color:var(--navy-deep); margin-bottom:3px;}
  .contact-card span{font-size:13px; color:var(--ink-soft); line-height:1.5;}
  .map-embed{border-radius:14px; overflow:hidden; border:1px solid var(--line); aspect-ratio:4/3; background:var(--paper-dim); display:flex; align-items:center; justify-content:center; color:var(--ink-soft); font-size:13px;}
  .form-panel{background:var(--navy-deep); border-radius:16px; padding:36px;}
  .form-panel h3{color:#fff; font-size:18px; margin-bottom:22px;}
  .field{margin-bottom:16px;}
  .field label{display:block; font-size:12px; color:var(--color-on-primary); margin-bottom:6px; font-weight:500;}
  .field input, .field textarea{width:100%; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.14); border-radius:8px; padding:11px 13px; color:#fff; font-family:'Inter',sans-serif; font-size:13.5px;}
  .field input::placeholder, .field textarea::placeholder{color:var(--color-text);}
  .field textarea{resize:vertical; min-height:90px;}

  /* ===== Policy / Service Charter ===== */
  .charter-wrap{display:grid; grid-template-columns:220px 1fr; gap:56px;}
  .charter-audio{display:flex; align-items:center; gap:14px; background:var(--paper-dim); border:1px solid var(--line); border-radius:12px; padding:16px 20px; margin-bottom:32px;}
  .charter-audio .play{width:36px; height:36px; border-radius:50%; background:var(--navy); color:#fff; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:13px;}
  .charter-audio span{font-size:13px; color:var(--ink-soft);}
  .charter-section{margin-bottom:36px;}
  .charter-section h3{font-size:16.5px; margin-bottom:12px;}
  .charter-section p{font-size:13.5px; color:var(--ink-soft); line-height:1.7;}

  /* ===== Footer ===== */
  footer{background:var(--navy-deep); color:var(--color-on-primary); padding-top:64px;}
  .footer-grid{display:grid; grid-template-columns:1.3fr 1fr 1fr 1fr; gap:40px; padding-bottom:48px; border-bottom:1px solid rgba(255,255,255,0.1);}
  .footer-brand .name{color:#fff; font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:16px; margin-bottom:10px;}
  .footer-brand p{font-size:13px; line-height:1.6; color:var(--color-on-primary); max-width:260px;}
  .footer-col h4{color:#fff; font-size:12.5px; letter-spacing:0.04em; text-transform:uppercase; margin-bottom:16px; font-weight:600;}
  .footer-col a{display:block; font-size:13.5px; color:var(--color-on-primary); margin-bottom:11px; transition:color .15s;}
  .footer-col a:hover{color:#fff;}
  .footer-bottom{display:flex; justify-content:space-between; align-items:center; padding:22px 0; font-size:12.5px; color:var(--color-on-primary); flex-wrap:wrap; gap:10px;}
  .footer-social{display:flex; gap:14px;}
  .footer-social a{width:32px; height:32px; border-radius:8px; background:rgba(255,255,255,0.06); display:flex; align-items:center; justify-content:center; color:var(--color-on-primary); font-size:12px; transition:background .15s;}
  .footer-social a:hover{background:var(--red); color:#fff;}

  @media (max-width: 1023px){
    .brand{flex:0 1 auto;}
    nav.wrap{justify-content:space-between;}
    .nav-links{display:none;}
    nav.wrap{height:68px;}
    .nav-links.is-open{position:absolute; top:calc(100% + 1px); right:20px; left:20px; display:flex; flex-direction:column; align-items:stretch; gap:2px; padding:10px; border:1px solid var(--line); border-radius:0 0 10px 10px; background:var(--paper); box-shadow:0 18px 36px -20px rgba(15,42,70,0.35); font-size:15px;}
    .nav-links.is-open > a,
    .nav-links.is-open > .has-drop > a,
    .nav-links.is-open > .has-drop > .nav-parent{display:flex; width:100%; min-height:44px; align-items:center; justify-content:space-between; padding:12px 10px; border-radius:6px; text-align:left;}
    .nav-links.is-open > a:hover,
    .nav-links.is-open > .has-drop > .nav-parent:hover{background:var(--paper-dim);}
    .nav-links.is-open .has-drop{width:100%;}
    .nav-links.is-open .has-drop.is-expanded .nav-parent::after{content:"−"; color:var(--red);}
    .nav-links.is-open .has-drop:not(.is-expanded) .nav-parent::after{content:"+"; color:var(--red);}
    .nav-links.is-open .drop{position:static; display:none; min-width:0; padding:0 0 4px 14px; border:0; border-radius:0; box-shadow:none; opacity:1; visibility:visible; transform:none;}
    .nav-links.is-open .has-drop.is-expanded .drop{display:block;}
    .nav-links.is-open .drop a{padding:9px 10px; font-size:14px;}
    .nav-cta{margin-left:auto;}
    .nav-cta .btn{display:none;}
    .mobile-toggle{display:block;}
    .hero-inner{grid-template-columns:1fr; padding:56px 24px 64px;}
    .hero h1{font-size:34px;}
    .hero-stats{flex-wrap:wrap;}
    .dept-grid{grid-template-columns:repeat(2,1fr);}
    .pillars{grid-template-columns:1fr; gap:32px; padding:44px 28px;}
    .pillar + .pillar{border-left:none; border-top:1px solid rgba(255,255,255,0.12); padding-top:28px;}
    .downloads-panel{grid-template-columns:1fr;}
    .downloads-right{grid-template-columns:1fr;}
    .principal{grid-template-columns:1fr;}
    .footer-grid{grid-template-columns:1fr 1fr;}
    .about-grid, .charter-wrap{grid-template-columns:1fr;}
    .about-nav{position:static; display:flex; gap:6px; overflow-x:auto; margin-bottom:24px;}
    .about-nav a{border-left:none; border-bottom:2px solid var(--line); padding:8px 12px; white-space:nowrap;}
    .dept-detail{grid-template-columns:1fr;}
    .contact-grid{grid-template-columns:1fr;}
    .masonry{columns:2 160px;}
    .values-grid{grid-template-columns:1fr;}
    .wrap{padding:0 20px;}
    #page-home > section{padding-block:88px;}
  }

  @media (max-width: 600px){
    .utility .wrap{height:auto; align-items:stretch; flex-direction:column; gap:4px; padding-top:7px; padding-bottom:7px;}
    .utility-links{justify-content:space-between; gap:8px; flex-wrap:wrap; font-size:11px;}
    .utility-social{justify-content:flex-end; gap:8px;}
    .utility-social .social-label{display:none;}
    .utility-social .social-icon{display:grid; place-items:center; width:30px; height:30px; border:1px solid rgba(255,255,255,.25); border-radius:50%; font-size:13px;}
    .brand-text .name{font-size:13px;}
    .crest{width:40px; height:40px; flex-basis:40px;}
    .hero-inner{padding:48px 20px 56px;}
    .hero h1{font-size:clamp(2rem,10vw,2.7rem); overflow-wrap:normal;}
    .hero p.lead{font-size:15px;}
    .hero-actions{flex-wrap:wrap; margin-bottom:32px;}
    .hero-actions .btn{min-height:44px;}
    .hero-stats{gap:16px; flex-wrap:wrap;}
    .page-header{padding:42px 0 32px;}
    .page-header h1{font-size:clamp(1.75rem,8vw,2.35rem); line-height:1.12;}
    section{padding:64px 0;}
    #page-home > section{padding-block:64px;}
    .section-head h2{font-size:clamp(1.65rem,7vw,2.1rem); line-height:1.12;}
    .about-grid{gap:28px;}
    .about-nav{position:relative; display:flex; gap:4px; margin-bottom:4px; padding-bottom:4px; overflow-x:auto; overscroll-behavior-x:contain; box-shadow:inset -22px 0 16px -18px var(--navy);}
    .about-nav a{flex:0 0 auto; min-height:44px; padding:10px 12px; border-left:0; border-bottom:2px solid var(--line); white-space:nowrap;}
    .about-block h2{font-size:clamp(1.45rem,6.5vw,1.9rem);}
    .downloads-left{padding:32px 24px;}
    .downloads-right{padding:20px 16px;}
    .dl-item{min-height:44px; padding:12px 8px; gap:12px; font-size:13px;}
    .pillars{padding:36px 24px;}
    .principal blockquote{font-size:clamp(1.2rem,5vw,1.5rem);}
    .contact-grid,.about-grid,.dept-detail{min-width:0;}
    .masonry{columns:1;}
    .field input,.field textarea{min-height:44px;}
    .notice-list{margin-top:22px;}
    .notice-row{grid-template-columns:1fr; gap:16px; padding:16px;}
    .notice-actions{justify-content:stretch;}
    .notice-actions .button{justify-content:center; width:100%; min-height:44px;}
  }

  @media (max-width: 430px){
    .wrap{padding-left:16px; padding-right:16px;}
    nav.wrap{height:64px; padding-left:16px; padding-right:16px;}
    .nav-links.is-open{right:16px; left:16px;}
    .utility-links{justify-content:flex-start;}
    .utility-links a{min-height:30px; display:inline-flex; align-items:center;}
    .hero-inner{padding-left:16px; padding-right:16px;}
    .hero-actions{flex-direction:column; align-items:stretch;}
    .hero-actions .btn{justify-content:center; width:100%;}
  }
</style>
</head>
<body>

  <header class="main">
    <nav class="wrap">
      <a class="brand" data-nav="home">
        <img class="crest" src="/images/mtvc-crest.png" alt="" />
        <div class="brand-text"><div class="name">Mathioya Technical<br>& Vocational College</div></div>
      </a>
      <div class="nav-links" id="navLinks">
        <a data-nav="home">Home</a>
        <a data-nav="about">About</a>
        <a data-nav="admissions">Admissions</a>
        <div class="has-drop">
          <button class="nav-parent" type="button" aria-expanded="false">Departments</button>
          <div class="drop">
            <a data-nav="departments">All Departments</a>
            {departments.map((department) => <a data-nav={department.id}>{department.short}</a>)}
          </div>
        </div>
        <a data-nav="gallery">Gallery</a>
        <a href="#page-jobs" data-nav="jobs">Jobs</a>
        <a href="#page-tenders" data-nav="tenders">Tender</a>
        <div class="has-drop">
          <button class="nav-parent" type="button" aria-expanded="false">Policy</button>
          <div class="drop">
            <a data-nav="policy">Service Charter</a>
          </div>
        </div>
        <a data-nav="contact">Contact</a>
      </div>
      <div class="nav-cta">
        <a data-nav="admissions" class="btn btn-primary">Apply Now</a>
        <button class="mobile-toggle" type="button" aria-controls="navLinks" aria-expanded="false" aria-label="Open navigation">&#9776;</button>
      </div>
    </nav>
  </header>

  <!-- ============ HOME ============ -->
  <div class="page active" id="page-home">
    <div class="announcement-ribbon" aria-label="Important announcements">
      <div class="announcement-track">
        <a class="announcement-item" href="#page-admissions" data-nav="admissions">January 2027 intake is now ongoing — Apply for admission</a>
        <a class="announcement-item" href="#page-announcements" data-nav="announcements">First-ever Graduation Ceremony — 5 February 2027 — Read more</a>
        <a class="announcement-item" href="#page-admissions" data-nav="admissions" tabindex="-1" aria-hidden="true">January 2027 intake is now ongoing — Apply for admission</a>
        <a class="announcement-item" href="#page-announcements" data-nav="announcements" tabindex="-1" aria-hidden="true">First-ever Graduation Ceremony — 5 February 2027 — Read more</a>
      </div>
    </div>
    <section class="hero" style="padding:0;">
      <div class="hero-inner wrap">
        <div>
          <span class="eyebrow">May 2026 Intake Open</span>
          <h1>Hands-on skills for self&#8209;reliance.</h1>
          <p class="lead">Competency-based technical and vocational training across seven departments, preparing trainees for employment, self-employment, and industry leadership.</p>
          <div class="hero-actions">
            <a data-nav="admissions" class="btn btn-red">Apply for Admission</a>
            <a data-nav="departments" class="btn btn-outline">View Departments</a>
          </div>
          <div class="hero-stats">
            <div><div class="num">7</div><div class="label">Departments</div></div>
            <div><div class="num">CBET</div><div class="label">Training Model</div></div>
            <div><div class="num">2018</div><div class="label">First Intake</div></div>
          </div>
        </div>
        <div class="hero-visual" aria-label="MTVC practical training photos">
          <div class="hero-slide active" data-hero-slide>
            <img src="/images/homepage/Building and Civil section visit by PS Dr. Mworia.jpg" alt="Visit by PS Dr. Mworia to the Building and Civil Engineering section">
            <div class="hero-visual-tag"><div class="dot"></div><span>Building & Civil Engineering section visit</span></div>
          </div>
          <div class="hero-slide" data-hero-slide>
            <img src="/images/homepage/Homebased Care.jpg" alt="Homebased Care training at MTVC">
            <div class="hero-visual-tag"><div class="dot"></div><span>Homebased Care training</span></div>
          </div>
          <div class="hero-slide" data-hero-slide>
            <img src="/images/homepage/Ongoing driving classes.jpg" alt="Ongoing driving classes at MTVC">
            <div class="hero-visual-tag"><div class="dot"></div><span>Ongoing driving classes</span></div>
          </div>
          <div class="hero-slide" data-hero-slide>
            <img src="/images/homepage/Tree Planting.jpg" alt="Tree planting activity at MTVC">
            <div class="hero-visual-tag"><div class="dot"></div><span>Tree planting at MTVC</span></div>
          </div>
          <div class="hero-dots" aria-label="Choose hero image">
            <button class="hero-dot active" type="button" aria-label="Show PS visit" data-hero-dot="0"></button>
            <button class="hero-dot" type="button" aria-label="Show Homebased Care training" data-hero-dot="1"></button>
            <button class="hero-dot" type="button" aria-label="Show driving classes" data-hero-dot="2"></button>
            <button class="hero-dot" type="button" aria-label="Show tree planting" data-hero-dot="3"></button>
          </div>
        </div>
      </div>
    </section>

    <div class="strip">
      <div class="wrap">
        <div class="strip-item"><span class="strip-badge">New</span> <b>Online applications</b> now open for May 2026 intake</div>
        <div class="strip-item">Registered under <b>TVETA</b>, admitted first students in 2018</div>
        <div class="strip-item">Vision 2030 aligned <b>demand-driven programs</b></div>
      </div>
    </div>

    <section class="wrap">
      <div class="pillars">
        <div class="pillar"><div class="icon">&#9670;</div><h3>Our Motto</h3><p>Hands-on skill for self-reliance. Training built on doing, not just knowing.</p></div>
        <div class="pillar"><div class="icon">&#9673;</div><h3>Our Mission</h3><p>To produce globally competitive graduates through competency-based education and training.</p></div>
        <div class="pillar"><div class="icon">&#9671;</div><h3>Our Vision</h3><p>To be a world-class technical college for sustainable development.</p></div>
      </div>
    </section>

    <section class="wrap">
      <div class="principal">
        <div class="principal-photo"><img src="/images/homepage/Principal.jpg" alt="Principal of Mathioya Technical & Vocational College"></div>
        <div>
          <span class="kicker" style="color:var(--red);">Message from the Principal</span>
          <blockquote>&#8220;We are committed to providing quality technical and vocational training that equips students with practical skills, knowledge, and values for the modern workforce.&#8221;</blockquote>
          <div class="attribution"><div class="bar"></div><div><div class="name">The Principal</div><div class="role">Mathioya Technical & Vocational College</div></div></div>
        </div>
      </div>
    </section>

    <section class="wrap">
      <div class="section-head">
        <div><span class="kicker">Departments</span><h2>Seven paths, one standard of craft.</h2></div>
        <p>Every department follows the same competency-based framework, built with industry to match real workforce demand.</p>
      </div>
      <div class="dept-grid">
        {departments.map((department, index) => <a class="dept-card" data-nav={department.id}><span class="dept-num">{String(index + 1).padStart(2, "0")}</span><h3>{department.short}</h3><span class="arrow">Explore &rarr;</span></a>)}
        <a class="dept-card" data-nav="admissions" style="background:var(--paper-dim);"><span class="dept-num">+</span><h3 style="color:var(--ink-soft);">General admission requirements, all departments</h3><span class="arrow">View &rarr;</span></a>
      </div>
    </section>

    <section class="wrap">
      <div class="downloads-panel">
        <div class="downloads-left">
          <span class="kicker">Admissions</span>
          <h2>Everything you need to apply, in one place.</h2>
          <p>Forms, fee structure, and requirements for the May 2026 intake. New applicants should download all documents except the brochure.</p>
          <a data-nav="admissions" class="btn btn-red" style="align-self:flex-start;">Start Application &rarr;</a>
        </div>
        <div class="downloads-right">
          <a href="#" class="dl-item">Application Form <span class="ico">&#8681;</span></a>
          <a href="#" class="dl-item">Medical Form <span class="ico">&#8681;</span></a>
          <a href="#" class="dl-item">Admission Letter <span class="ico">&#8681;</span></a>
          <a href="#" class="dl-item">Fee Structure <span class="ico">&#8681;</span></a>
          <a href="#" class="dl-item">Rules & Regulations <span class="ico">&#8681;</span></a>
          <a href="#" class="dl-item">College Brochure <span class="ico">&#8681;</span></a>
        </div>
      </div>
    </section>

    <section class="wrap partners-section">
      <div class="section-head">
        <div><span class="kicker">Our Partners</span><h2>Working together to strengthen technical training.</h2></div>
        <p>MTVC works with education, training, assessment, and industry partners to support quality training and student progression.</p>
      </div>
      <img class="partners-image" src="/images/our-partners.jpg" alt="Logos of Mathioya Technical and Vocational College partners">
    </section>
  </div>

  <div class="page" id="page-jobs">
    <div class="page-header">
      <div class="wrap">
        <div class="breadcrumb"><a data-nav="home">Home</a><span class="sep">/</span><span>Jobs</span></div>
        <h1>Jobs and opportunities</h1>
        <p>Current vacancies and opportunities at Mathioya Technical & Vocational College.</p>
      </div>
    </div>
    <section class="wrap">
      <div class="section-head">
        <div><span class="kicker">Opportunities</span><h2>Join the MTVC team.</h2></div>
        <p>Review current opportunities and follow the instructions in each advert.</p>
      </div>
      {jobs.length ? <div class="notice-list">{jobs.map((entry) => (
        <article class="notice-row">
          <div class="notice-main"><div class="notice-title-line"><h3>{entry.data.title}</h3><span class:list={["status-badge", isClosingSoon(entry.data.closingDate) ? "status-soon" : "status-open"]}>{isClosingSoon(entry.data.closingDate) ? "Closing soon" : "Open"}</span></div><p>{entry.data.department}</p><small>Closing {formatDate(entry.data.closingDate)}</small></div>
          <div class="notice-actions">{entry.data.attachment?.toLowerCase().endsWith(".pdf") && <a class="button button-small button-outline-dark" href={entry.data.attachment} target="_blank" rel="noreferrer">Download notice</a>}</div>
        </article>
      ))}</div> : <p>No current job adverts are published.</p>}
    </section>
  </div>

  <div class="page" id="page-tenders">
    <div class="page-header">
      <div class="wrap">
        <div class="breadcrumb"><a data-nav="home">Home</a><span class="sep">/</span><span>Tenders</span></div>
        <h1>Tenders and procurement notices</h1>
        <p>Current procurement notices from Mathioya Technical & Vocational College.</p>
      </div>
    </div>
    <section class="wrap">
      <div class="section-head">
        <div><span class="kicker">Procurement</span><h2>Current tender notices.</h2></div>
        <p>Review the notice details and download any supporting documents.</p>
      </div>
      {tenders.length ? <div class="notice-list">{tenders.map((entry) => (
        <article class="notice-row">
