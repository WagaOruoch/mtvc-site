---
import { getCollection } from "astro:content";
import { activeAnnouncements, activeJobs, activeTenders, isClosingSoon } from "../lib/content";
import "../styles/brand.css";

const announcements = activeAnnouncements(await getCollection("announcements")).filter(
  (entry) => entry.slug !== "placeholder",
);
const jobs = activeJobs(await getCollection("jobs")).filter((entry) => entry.slug !== "placeholder");
const tenders = activeTenders(await getCollection("tenders")).filter((entry) => entry.slug !== "placeholder");
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", year: "numeric" }).format(date);
const departments = [
  {
    id: "dept-ict",
    short: "ICT",
    title: "Information & Communication Technology",
    image: "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?q=80&w=700&auto=format&fit=crop",
    alt: "ICT computer lab",
    intro: "Build practical digital skills for modern workplaces through computer applications, information systems, networking, and user support.",
    objectives: ["Develop confident computer users and digital problem-solvers", "Build practical skills in software, networks, and information systems", "Support innovation, online services, and digital entrepreneurship"],
    programs: ["Diploma in Information Communication Technology", "Certificate in Information Technology", "Computer Applications / Packages"],
  },
  {
    id: "dept-mechanical",
    short: "Mechanical",
    title: "Mechanical Engineering / Automotive",
    image: "https://images.unsplash.com/photo-1487754180451-c456f719a1fc?q=80&w=700&auto=format&fit=crop",
    alt: "Automotive mechanical workshop",
    intro: "Learn through workshop-based training in vehicle systems, maintenance, diagnostics, fabrication, and safe use of tools and equipment.",
    objectives: ["Develop hands-on competence in vehicle inspection and maintenance", "Apply workshop safety, measurement, and diagnostic practices", "Prepare trainees for automotive service, repair, and self-employment"],
    programs: ["Automotive Engineering", "Motor Vehicle Mechanics", "Automotive short courses and driving-related skills"],
  },
  {
    id: "dept-cosmetology",
    short: "Cosmetology",
    title: "Cosmetology",
    image: "https://images.unsplash.com/photo-1562322140-8baeececf3df?q=80&w=700&auto=format&fit=crop",
    alt: "Cosmetology salon training",
    intro: "Develop professional beauty and personal-care skills through practical training in hairdressing, skincare, grooming, and salon enterprise.",
    objectives: ["Build safe and professional personal-care techniques", "Develop client care, hygiene, and salon management skills", "Encourage creative practice and sustainable beauty enterprises"],
    programs: ["Hairdressing and Beauty Therapy", "Cosmetology", "Beauty and personal-care short courses"],
  },
  {
    id: "dept-business",
    short: "Business",
    title: "Business Studies",
    image: "https://images.unsplash.com/photo-1556761175-b413da4baf72?q=80&w=700&auto=format&fit=crop",
    alt: "Business studies class",
    intro: "Gain practical business and office skills for administration, accounting, entrepreneurship, customer service, and small-enterprise management.",
    objectives: ["Build strong foundations in business administration and records", "Apply accounting, communication, and customer-service skills", "Prepare trainees to manage workplaces and start sustainable enterprises"],
    programs: ["Business Management", "Accounting and Finance", "Office administration and entrepreneurship"],
  },
  {
    id: "dept-hospitality",
    short: "Hospitality",
    title: "Hospitality & Institutional Management",
    image: "https://images.unsplash.com/photo-1556910103-1c02745aae4d?q=80&w=700&auto=format&fit=crop",
    alt: "Hospitality practical training",
    intro: "Prepare for service-focused careers through practical training in food production, hospitality operations, housekeeping, and customer care.",
    objectives: ["Develop professional food preparation and service routines", "Apply hygiene, safety, and hospitality standards", "Build communication and enterprise skills for hospitality workplaces"],
    programs: ["Food and Beverage Production", "Food and Beverage Service", "Housekeeping and institutional management"],
