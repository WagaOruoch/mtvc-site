---
import { getCollection } from "astro:content";
import { activeTenders, archivedTenders } from "../../lib/content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const entries = await getCollection("tenders");
const current = activeTenders(entries).filter((entry) => entry.slug !== "placeholder");
const archive = archivedTenders(entries).filter((entry) => entry.slug !== "placeholder");
---
<BaseLayout title="Tenders">
  <section class="page-hero"><div class="container"><p class="eyebrow">Procurement</p><h1>Tenders</h1></div></section>
  <section class="container section">
    <h2>Current notices</h2>
    {current.length ? <div class="card-grid three">{current.map((entry) => <a class="card card-link" href={`/tenders/${entry.slug}/`}><h3>{entry.data.title}</h3><p>{entry.data.type} · {entry.data.reference}</p><small>Closes {entry.data.closingDate.toLocaleDateString()}</small></a>)}</div> : <p>No current tender notices are published.</p>}
    {archive.length > 0 && <><h2 class="archive-heading">Recent archive</h2><div class="card-grid three">{archive.map((entry) => <a class="card card-link" href={`/tenders/${entry.slug}/`}><h3>{entry.data.title}</h3><p>Closed {entry.data.closingDate.toLocaleDateString()}</p></a>)}</div></>}
  </section>
</BaseLayout>
