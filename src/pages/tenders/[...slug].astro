---
import { getCollection } from "astro:content";
import PublicLayout from "../../layouts/PublicLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("tenders");
  return entries.filter((entry) => entry.slug !== "placeholder").map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", year: "numeric" }).format(date);
---
<PublicLayout title={entry.data.title} description={entry.data.description}>
  <section class="page-hero"><div class="container"><p class="eyebrow">{entry.data.type}</p><h1>{entry.data.title}</h1><p>{entry.data.reference}</p></div></section>
  <section class="container section detail-page">
    <a class="back-link" href="/tenders/">← Back to all tenders</a>
    <div class="detail-meta"><span>Posted {formatDate(entry.data.postedDate)}</span><span>Closing {formatDate(entry.data.closingDate)}</span>{entry.data.openingDate && <span>Opening {formatDate(entry.data.openingDate)}</span>}</div>
    <div class="prose"><p>{entry.data.description}</p><Content /></div>
    {entry.data.attachments.length > 0 && <section class="public-attachments"><h2>Tender attachments</h2><div class="public-attachment-grid">{entry.data.attachments.map((file) => <article class="public-attachment">{file.toLowerCase().endsWith(".pdf") && <iframe class="public-pdf-preview" src={file} title={`Preview of ${entry.data.title} attachment`}></iframe>}<a class="button button-danger" href={file} target="_blank" rel="noreferrer">Download attachment</a></article>)}</div></section>}
  </section>
</PublicLayout>
