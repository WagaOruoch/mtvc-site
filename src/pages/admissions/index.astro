---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const requirements = await getCollection("department-requirements");
const intakes = await getCollection("intakes");
const currentIntake = intakes[0];
---
<BaseLayout title="Admissions">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Admissions</p>
      <h1>September 2026 intake information</h1>
      <p>Select your department for requirements, then download the confirmed application documents.</p>
    </div>
  </section>
  <section class="container section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Requirements</p>
        <h2>General requirements by department</h2>
      </div>
      <p>Current requirement PDFs will be published here after the college confirms the approved admissions pack.</p>
    </div>
    <div class="card-grid three">
      {requirements.map((entry) => (
        <article class="card">
          <h3>{entry.data.department}</h3>
          <p>{entry.data.description || entry.data.title}</p>
          {entry.data.document ? <a class="button button-small" href={entry.data.document} target="_blank" rel="noreferrer">View requirements</a> : <span class="muted">Requirements document pending.</span>}
        </article>
      ))}
    </div>
  </section>
  <section class="container section">
    <div class="downloads-panel">
      <div class="downloads-left">
        <p class="eyebrow">Documents</p>
        <h2>Application forms and downloads</h2>
        <p>{currentIntake?.data.description || "Complete the official online application form for the current intake."}</p>
        {currentIntake && <a class="button button-danger" href={currentIntake.data.applicationUrl} target="_blank" rel="noreferrer">Apply for this intake</a>}
      </div>
      <div class="downloads-right">
        <div class="dl-item">Application form <span>Pending</span></div>
        <div class="dl-item">Admission letter <span>Pending</span></div>
        <div class="dl-item">Fee structure <span>Pending</span></div>
        <div class="dl-item">Registration form <span>Pending</span></div>
        <div class="dl-item">Medical certificate <span>Pending</span></div>
        <div class="dl-item">Rules and regulations <span>Pending</span></div>
      </div>
    </div>
  </section>
</BaseLayout>
