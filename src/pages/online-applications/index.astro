---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const intakes = await getCollection("intakes");
---
<BaseLayout title="Online applications">
  <section class="page-hero"><div class="container"><p class="eyebrow">Admissions</p><h1>Online applications</h1></div></section>
  <section class="container section prose"><h2>Apply to MTVC</h2><p>Use the college’s official admissions form to submit an application. The form remains managed by MTVC and is not recreated on this website.</p>{intakes.map((intake) => <p><a class="button" href={intake.data.applicationUrl} target="_blank" rel="noreferrer">{intake.data.title}</a></p>)}<h2>Funding information</h2><p>Information about the current higher education funding model will be added after the college confirms the official guidance link.</p></section>
</BaseLayout>
