---
import BaseLayout from "../../layouts/BaseLayout.astro";
const departments = [
  ["Mechanical Engineering", "automotive"],
  ["ICT", "ict"],
  ["Cosmetology", "cosmetology"],
  ["Business", "business"],
  ["Hospitality & Institutional Management", "hospitality"],
  ["Building & Civil Engineering", "building-civil-engineering"],
  ["Electrical & Electronics Engineering", "electrical-electronics-engineering"],
];
---
<BaseLayout title="Departments">
  <section class="page-hero"><div class="container"><p class="eyebrow">Explore training</p><h1>Departments</h1></div></section>
  <section class="container section"><div class="card-grid three">
    {departments.map(([name, slug]) => <a class="card card-link" href={`/departments/${slug}/`}><h2>{name}</h2><span>View department →</span></a>)}
  </div></section>
</BaseLayout>
