---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  const departments: Record<string, { title: string; summary: string }> = {
    automotive: { title: "Mechanical Engineering", summary: "Automotive training information will be added from the confirmed college prospectus." },
    ict: { title: "ICT", summary: "ICT training information will be added from the confirmed college prospectus." },
    cosmetology: { title: "Cosmetology", summary: "Cosmetology training information will be added from the confirmed college prospectus." },
    business: { title: "Business", summary: "Business training information will be added from the confirmed college prospectus." },
    hospitality: { title: "Hospitality & Institutional Management", summary: "Hospitality training information will be added from the confirmed college prospectus." },
    "building-civil-engineering": { title: "Building & Civil Engineering", summary: "Building and civil engineering information will be added from the confirmed college prospectus." },
    "electrical-electronics-engineering": { title: "Electrical & Electronics Engineering", summary: "Electrical and electronics information will be added from the confirmed college prospectus." },
  };

  return Object.keys(departments).map((slug) => ({ params: { slug }, props: departments[slug] }));
}

const { title, summary } = Astro.props;
const requirements = (await getCollection("department-requirements")).filter((entry) => {
  const department = entry.data.department.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  const pageTitle = title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  return department === pageTitle || department === Astro.params.slug;
});
---
<BaseLayout title={title}>
  <section class="page-hero"><div class="container"><p class="eyebrow">Department</p><h1>{title}</h1></div></section>
  <section class="container section prose"><h2>Training at MTVC</h2><p>{summary}</p><p>Course levels, entry requirements, duration, examination body, and department contacts will be published after ICT confirms the current academic information.</p><a class="button" href="/admissions/">View admissions information</a></section>
  {requirements.length > 0 && <section class="container section"><div class="section-heading"><div><p class="eyebrow">Admissions</p><h2>Department requirements</h2></div><p>Download the approved requirements document for this department and intake.</p></div><div class="card-grid three">{requirements.map((entry) => <article class="card"><h3>{entry.data.intake}</h3><p>{entry.data.description || entry.data.title}</p>{entry.data.document && <a class="button button-small" href={entry.data.document} target="_blank" rel="noreferrer">View requirements</a>}</article>)}</div></section>}
</BaseLayout>
