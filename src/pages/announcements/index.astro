---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { activeAnnouncements } from "../../lib/content";

const entries = activeAnnouncements(await getCollection("announcements")).filter(
  (entry) => entry.slug !== "placeholder",
);
---
<BaseLayout title="Announcements">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">College updates</p>
      <h1>Announcements</h1>
      <p>Current posts and banners published by the college.</p>
    </div>
  </section>
  <section class="container section">
    {entries.length ? (
      <div class="card-grid three">
        {entries.map((entry) => (
          <a class="card card-link" href={`/announcements/${entry.slug}/`}>
            <h2>{entry.data.title}</h2>
            <p>{entry.data.description}</p>
            <small>Available until {entry.data.endDate.toLocaleDateString()}</small>
          </a>
        ))}
      </div>
    ) : (
      <div class="prose">
        <h2>No current announcements</h2>
        <p>Approved posts and homepage banners will appear here after staff publish them through the CMS.</p>
      </div>
    )}
  </section>
</BaseLayout>
