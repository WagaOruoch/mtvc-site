---
interface Props {
  title: string;
  description?: string;
}

import "../styles/global.css";
import "../styles/brand.css";

const { title, description = "Mathioya Technical & Vocational College." } = Astro.props;
const currentPath = Astro.url.pathname;
const navigation = [
  { label: "Home", href: "/" },
  { label: "About", href: "/#page-about" },
  { label: "Admissions", href: "/#page-admissions" },
  { label: "Departments", href: "/#page-departments" },
  { label: "Gallery", href: "/#page-gallery" },
  { label: "Jobs", href: "/jobs/" },
  { label: "Tender", href: "/tenders/" },
  { label: "Policy", href: "/#page-policy" },
  { label: "Contact", href: "/#page-contact" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title} | Mathioya Technical & Vocational College</title>
  </head>
  <body>
    <header class="site-header public-header">
      <a class="skip-link" href="#main-content">Skip to content</a>
      <div class="container public-header-inner">
        <a class="brand" href="/">
          <img class="brand-mark" src="/images/mtvc-crest.png" alt="" />
          <strong>Mathioya Technical<br />& Vocational College</strong>
        </a>
        <nav class="public-nav" id="publicNav" aria-label="Main navigation">
          <a href="/" class:list={{ active: currentPath === "/" }}>Home</a>
          <a href="/#page-about">About</a>
          <a href="/#page-admissions">Admissions</a>
          <div class="public-nav-drop">
            <button type="button" aria-expanded="false">Departments</button>
            <div class="public-drop"><a href="/#page-departments">All Departments</a><a href="/#page-dept-ict">ICT</a></div>
          </div>
          <a href="/#page-gallery">Gallery</a>
          <a href="/jobs/">Jobs</a>
          <a href="/tenders/">Tender</a>
          <div class="public-nav-drop">
            <button type="button" aria-expanded="false">Policy</button>
            <div class="public-drop"><a href="/#page-policy">Service Charter</a></div>
          </div>
          <a href="/#page-contact">Contact</a>
        </nav>
        <a class="button button-small header-apply" href="/#page-admissions">Apply Now</a>
        <button class="public-mobile-toggle" type="button" aria-controls="publicNav" aria-expanded="false" aria-label="Open navigation">☰</button>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div><strong>Mathioya Technical & Vocational College</strong><p>Practical training for work, enterprise, and self-reliance.</p></div>
        <div><strong>Quick links</strong><a href="/">Home</a><a href="/#page-admissions">Admissions</a><a href="/#page-contact">Contact</a></div>
        <div><strong>Portals</strong><a href="/jobs/">Jobs</a><a href="/tenders/">Tenders</a><a href="https://elearning.mathioyatechnical.ac.ke/">ODeL</a><a href="/#page-contact">Staff portal</a></div>
        <div><strong>Contact</strong><p>Mathioya Technical & Vocational College, Kenya.</p><a href="/#page-contact">View contact information</a></div>
      </div>
      <div class="container footer-social-links"><a href="https://web.facebook.com/MathioyaTechnical">Facebook</a><a href="https://www.tiktok.com/@mathioyatechnical">TikTok</a><a href="https://wa.me/254790678738">WhatsApp</a></div>
      <div class="container copyright">© {new Date().getFullYear()} Mathioya Technical & Vocational College</div>
    </footer>
  </body>
  <script>
    const publicToggle = document.querySelector(".public-mobile-toggle");
    const publicNav = document.querySelector("#publicNav");
    publicToggle?.addEventListener("click", () => {
      if (!publicNav) return;
      const open = publicNav.classList.toggle("is-open");
      publicToggle.setAttribute("aria-expanded", String(open));
      publicToggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
    });
    document.querySelectorAll(".public-nav-drop > button").forEach((button) => {
      button.addEventListener("click", () => {
        const parent = button.parentElement;
        if (!parent) return;
        const expanded = parent.classList.toggle("is-expanded");
        button.setAttribute("aria-expanded", String(expanded));
      });
    });
  </script>
</html>
